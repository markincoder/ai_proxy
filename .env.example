# Скопируйте в .env в корне проекта (рядом с requirements.txt)

DATABASE_URL=sqlite:///./data/app.db

# Каталог для загруженных картинок новостей (от корня репозитория; в Docker смонтируйте вместе с БД).
# NEWS_UPLOAD_DIR=data/uploads/news

# Подпись cookie-сессии (или NEXTAUTH_SECRET из старого проекта)
SESSION_SECRET=

OPENROUTER_API_KEY=
OPENROUTER_APP_TITLE=II Proxy SaaS
# База URL API (без хвостового слеша); пути /models, /chat/completions и т.д. тот же префикс
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
# Slug маршрутизатора «бесплатных» моделей (должен совпадать с первой строкой в default_model_specs.json при необходимости)
# OPENROUTER_FREE_ROUTER_SLUG=openrouter/free
# CHAT threads с удалённой моделью перепривязываются на этот slug
# THREAD_MODEL_FALLBACK_SLUG=openai/gpt-4o
# Моделей нет в default_model_specs.json — строка в ai_models удаляется при старте автоматически.
# Через запятую: дополнительно убрать slug (даже если он ещё в JSON), перепривязать треды
# REMOVED_OPENROUTER_SLUGS=
# Для scripts/sync_openrouter_prices.py и бэкенда: USD → баланс пользователя = USD × OPENROUTER_USD_RUB × PRICING_MARKUP_MULT (чат/tokens при usage.cost, видео, цены моделей в БД)
OPENROUTER_USD_RUB=100
PRICING_MARKUP_MULT=2
# false — не использовать системный HTTP(S)_PROXY (при ConnectError к openrouter.ai)
OPENROUTER_HTTPX_TRUST_ENV=true

# Админка → «Модерация»: слова для поиска в текстах чатов (через запятую); в UI можно добавить ещё.
# FORBIDDEN_MESSAGE_KEYWORDS=

# Админка: после входа через OAuth выставить в БД users.is_admin = 1 для нужного id (см. README)

YOOKASSA_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Публичный URL сервиса (OAuth, ЮKassa, заголовок HTTP-Referer к OpenRouter)
NEXT_PUBLIC_APP_URL=http://localhost:8000

# Опционально: Яндекс ID и VK ID (redirect URI = NEXT_PUBLIC_APP_URL + путь из README)
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
VK_OAUTH_CLIENT_ID=
# Допустимо и VK_OAUTH_SECRET_KEY (как в кабинете VK)
VK_OAUTH_CLIENT_SECRET=
OAUTH_NEW_USER_BALANCE=0

INTERNAL_API_SECRET=
